# Database (defaults to local SQLite if unset)
DATABASE_URL=sqlite:///./codeguardian.db
# For PostgreSQL:
# DATABASE_URL=postgresql://guardian:guardian_secret_password@localhost:5432/codeguardian

# Google Gemini API Key (Optional for Demo Mode; required for live AI explanations)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# GitHub Personal Access Token (Optional; increases API rate limits for public PR scans)
GITHUB_TOKEN=your_github_token_here

# Safety Guardrails
ENABLE_GITHUB_COMMENTS=false
MAX_FILE_SIZE_BYTES=500000
MAX_CHANGED_FILES=50
SEMGREP_TIMEOUT_SECONDS=25
OWASP_VERSION=2025
